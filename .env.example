# Copie para .env (na raiz deste repo) e preencha. O .env é gitignored.
#
# Os dois valores são da MANAGER ACCOUNT (MCC) da empresa, iguais para todo mundo
# do time. O que é individual é o login OAuth — veja SETUP.md, passo 4.

# Developer token da MCC. Fica em ads.google.com/aw/apicenter, logado na MCC.
GOOGLE_ADS_DEVELOPER_TOKEN=

# ID da MCC, só dígitos ou com hífen. É a conta manager, NÃO a conta de anúncios.
# Vibe Digital: 187-999-9144
GOOGLE_ADS_LOGIN_CUSTOMER_ID=
